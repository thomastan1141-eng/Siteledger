rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accountPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasAccount() {
      return signedIn() && exists(accountPath());
    }

    function account() {
      return get(accountPath()).data;
    }

    function memberPath(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid);
    }

    function isWorkspaceMember(workspaceId) {
      return signedIn()
        && exists(memberPath(workspaceId))
        && get(memberPath(workspaceId)).data.status == 'ACTIVE';
    }

    function isWorkspaceOwner(workspaceId) {
      return isWorkspaceMember(workspaceId)
        && get(memberPath(workspaceId)).data.role == 'OWNER';
    }

    function companyUserPath(companyId) {
      return /databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid);
    }

    function hasCompanyUser(companyId) {
      return signedIn()
        && exists(companyUserPath(companyId))
        && get(companyUserPath(companyId)).data.active == true;
    }

    function companyProfile(companyId) {
      return get(companyUserPath(companyId)).data;
    }

    function isCompanyAdmin(companyId) {
      return hasCompanyUser(companyId) && companyProfile(companyId).role == 'admin';
    }

    function isAccountTenantAdmin(companyId) {
      return hasAccount()
        && account().active == true
        && account().role == 'admin'
        && (
          account().defaultWorkspaceId == companyId
          || account().companyId == companyId
        );
    }

    // Workspace/company-level docs only (workspaces, companies/*/meta,
    // workCategories, auditEvents). NEVER use this for Project access —
    // company admin / workspace owner grant no authority over Projects.
    function isTenantAdmin(companyId) {
      return isCompanyAdmin(companyId) || isWorkspaceOwner(companyId);
    }

    function isCompanyStaffSide(companyId) {
      return hasCompanyUser(companyId)
        && companyProfile(companyId).role in ['admin', 'staff'];
    }

    function isCompanyClient(companyId) {
      return hasCompanyUser(companyId) && companyProfile(companyId).role == 'client';
    }

    function canAccessTenant(companyId) {
      return isTenantAdmin(companyId)
        || isCompanyStaffSide(companyId)
        || isWorkspaceMember(companyId);
    }

    function projectDoc(companyId, projectId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)).data;
    }

    function projectClientUserIds(companyId, projectId) {
      return projectDoc(companyId, projectId).get('clientUserIds', []);
    }

    function projectStaffIds(companyId, projectId) {
      return projectDoc(companyId, projectId).get('staffIds', []);
    }

    function projectMemberPath(companyId, projectId) {
      return /databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)/members/$(request.auth.uid);
    }

    // Member doc is authoritative. Arrays are query indexes only.
    function hasActiveProjectMember(companyId, projectId) {
      return signedIn()
        && exists(projectMemberPath(companyId, projectId))
        && get(projectMemberPath(companyId, projectId)).data.get('status', '') == 'ACTIVE';
    }

    function projectMember(companyId, projectId) {
      return get(projectMemberPath(companyId, projectId)).data;
    }

    function isProjectCreatorOf(companyId, projectId) {
      return signedIn()
        && projectDoc(companyId, projectId).get('createdBy', '') == request.auth.uid;
    }

    function isAssignedColleague(companyId, projectId) {
      return signedIn()
        && request.auth.uid in projectStaffIds(companyId, projectId)
        && hasActiveProjectMember(companyId, projectId)
        && projectMember(companyId, projectId).get('memberType', 'COLLEAGUE')
            in ['COLLEAGUE', 'STAFF', 'OWNER'];
    }

    // Client is a project member type — not a global/company user role.
    function isAssignedClient(companyId, projectId) {
      return signedIn()
        && request.auth.uid in projectClientUserIds(companyId, projectId)
        && hasActiveProjectMember(companyId, projectId)
        && projectMember(companyId, projectId).get('memberType', 'CLIENT')
            == 'CLIENT';
    }

    // Only the Project creator manages/reads everything on their Project.
    // Company admin and workspace owner grant no Project authority.
    function canManageProject(companyId, projectId) {
      return isProjectCreatorOf(companyId, projectId);
    }

    function colleagueAllows(companyId, projectId, perm) {
      return canManageProject(companyId, projectId)
        || (
          isAssignedColleague(companyId, projectId)
          && (
            projectMember(companyId, projectId).get('permissionPreset', '') == 'OWNER'
            || projectMember(companyId, projectId).get('memberType', '') == 'OWNER'
            || projectMember(companyId, projectId)
                .get('permissions', {})
                .get(perm, false) == true
            || (
              projectMember(companyId, projectId).get('permissionPreset', '') == 'VIEW_ONLY'
              && perm in [
                'viewProject', 'viewSchedule', 'viewJournal',
                'viewMedia', 'downloadMedia', 'viewPurchases'
              ]
            )
            || (
              projectMember(companyId, projectId).get('permissionPreset', '') == 'UPDATE_PROGRESS'
              && perm in [
                'viewProject', 'viewSchedule', 'updateSchedule',
                'viewJournal', 'addJournal', 'editOwnJournal',
                'viewMedia', 'downloadMedia', 'uploadMedia',
                'editOwnMedia', 'deleteOwnMedia', 'viewPurchases'
              ]
            )
            || (
              projectMember(companyId, projectId).get('permissionPreset', '') == 'EDITOR'
              && perm != 'manageProjectAccess'
            )
          )
        );
    }

    function canEditOwnJournal(companyId, projectId) {
      return colleagueAllows(companyId, projectId, 'editOwnJournal')
        && resource.data.get('createdBy', '') == request.auth.uid;
    }

    function canDeleteOwnJournal(companyId, projectId) {
      return colleagueAllows(companyId, projectId, 'deleteOwnJournal')
        && resource.data.get('createdBy', '') == request.auth.uid;
    }

    function canEditOwnMedia(companyId, projectId) {
      return colleagueAllows(companyId, projectId, 'editOwnMedia')
        && resource.data.get('uploadedBy', '') == request.auth.uid;
    }

    function canDeleteOwnMedia(companyId, projectId) {
      return colleagueAllows(companyId, projectId, 'deleteOwnMedia')
        && resource.data.get('uploadedBy', '') == request.auth.uid;
    }

    function requestIsClientVisible() {
      return request.resource.data.get('clientVisible', false) == true
        || request.resource.data.get('visibility', 'internal') in ['client_visible', 'handover'];
    }

    function resourceIsClientVisible() {
      return resource.data.get('clientVisible', false) == true
        || resource.data.get('visibility', 'internal') in ['client_visible', 'handover'];
    }

    // Turning Media/Journal client-visible requires the creator, or a
    // colleague whose effectivePermissions grant publishMediaToClient AND
    // the Project itself allows staff publish — never a bare
    // uploadMedia/addJournal grant (UPDATE_PROGRESS has those but not
    // publishMediaToClient, so it can never publish to the client).
    function canPublishToClient(companyId, projectId) {
      return canManageProject(companyId, projectId)
        || (
          colleagueAllows(companyId, projectId, 'publishMediaToClient')
          && projectDoc(companyId, projectId).get('allowStaffPublish', false) == true
        );
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if false;
      allow update: if signedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'role', 'active', 'defaultWorkspaceId', 'companyId',
              'onboardingComplete', 'plan', 'subscriptionStatus'
            ]);
      allow delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow read: if isWorkspaceMember(workspaceId)
        || isAccountTenantAdmin(workspaceId);
      allow create: if false;
      allow update: if isTenantAdmin(workspaceId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'ownerUid', 'plan', 'subscriptionStatus',
              'trialStartsAt', 'trialEndsAt'
            ]);
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isWorkspaceMember(workspaceId)
          || isAccountTenantAdmin(workspaceId)
          || (signedIn() && request.auth.uid == memberId);
        allow write: if false;
      }
    }

    match /companies/{companyId} {
      allow read: if isWorkspaceMember(companyId)
        || hasCompanyUser(companyId)
        || isAccountTenantAdmin(companyId);
      allow write: if isTenantAdmin(companyId);

      match /meta/{docId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && docId == 'setup'
          && !exists(/databases/$(database)/documents/companies/$(companyId)/meta/setup)
          && request.resource.data.adminUid == request.auth.uid
          && request.resource.data.completed == true;
        allow update, delete: if isCompanyAdmin(companyId);
      }

      match /users/{userId} {
        allow read: if isCompanyStaffSide(companyId)
          || (signedIn() && request.auth.uid == userId);
        allow create: if isCompanyAdmin(companyId)
          || (signedIn()
              && request.auth.uid == userId
              && request.resource.data.role == 'admin'
              && request.resource.data.companyId == companyId
              && request.resource.data.active == true
              && !exists(/databases/$(database)/documents/companies/$(companyId)/meta/setup));
        allow update: if isCompanyAdmin(companyId)
          || (signedIn() && request.auth.uid == userId
              && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['role', 'active', 'companyId', 'projectIds']));
        allow delete: if isCompanyAdmin(companyId);
      }

      match /workCategories/{categoryId} {
        allow read: if canAccessTenant(companyId);
        allow write: if isTenantAdmin(companyId);
      }

      match /reminders/{reminderId} {
        allow read, write: if canAccessTenant(companyId);
      }

      match /createRequests/{requestId} {
        allow read, write: if false;
      }

      match /auditEvents/{eventId} {
        allow read: if isTenantAdmin(companyId);
        allow write: if false;
      }

      match /projects/{projectId} {
        function projectNotTrashed() {
          return !('status' in resource.data)
            || !(resource.data.status in ['trashed', 'purging']);
        }

        function isProjectCreator() {
          return signedIn()
            && 'createdBy' in resource.data
            && resource.data.createdBy == request.auth.uid;
        }

        function resourceHasActiveMember() {
          return exists(projectMemberPath(companyId, projectId))
            && get(projectMemberPath(companyId, projectId)).data.get('status', '') == 'ACTIVE';
        }

        // Access is creator OR ACTIVE membership only — never company admin
        // or workspace owner. get: dual gate (array index + ACTIVE member).
        // list: array index only — Firestore list rules cannot reliably call
        // get() on member docs; Share/Unshare keep arrays atomic with member
        // status. Subcollections/Storage still dual-gated.
        allow get: if (
            projectNotTrashed()
            && (
              isProjectCreator()
              || (
                request.auth.uid in resource.data.get('staffIds', [])
                && resourceHasActiveMember()
              )
              || (
                request.auth.uid in resource.data.get('clientUserIds', [])
                && resourceHasActiveMember()
              )
            )
          )
          || (isProjectCreator()
              && resource.data.status in ['trashed', 'purging']);

        allow list: if (
            projectNotTrashed()
            && (
              isProjectCreator()
              || request.auth.uid in resource.data.get('staffIds', [])
              || request.auth.uid in resource.data.get('clientUserIds', [])
            )
          )
          || (isProjectCreator()
              && resource.data.status in ['trashed', 'purging']);

        // Every verified USER may create a Project in their own workspace.
        // ACTIVE workspace membership only validates "this is your own
        // namespace" — it grants no authority over other USERS' Projects.
        allow create: if signedIn()
          && request.auth.token.email_verified == true
          && isWorkspaceMember(companyId)
          && request.resource.data.workspaceId == companyId
          && request.resource.data.companyId == companyId
          && request.resource.data.createdBy == request.auth.uid;

        // EDITOR (and every non-creator) may only edit normal Project
        // content. createdBy/workspaceId/companyId are always immutable.
        // Lifecycle/status fields used for trash/purge/restore and the
        // sharing arrays (staffIds/clientUserIds) can only move through the
        // dedicated Admin-SDK routes (trash/restore/purge/share/unshare),
        // never through this generic client-side update — so any direct
        // write that would touch them, or leave status in trashed/purging,
        // is rejected here regardless of who the caller is.
        allow update: if projectNotTrashed()
          && (
            isProjectCreator()
            || colleagueAllows(companyId, projectId, 'editProjectDetails')
          )
          && request.resource.data.companyId == resource.data.companyId
          && (
            !('workspaceId' in resource.data)
            || resource.data.workspaceId == null
            || request.resource.data.workspaceId == resource.data.workspaceId
          )
          && (
            !('createdBy' in resource.data)
            || resource.data.createdBy == null
            || request.resource.data.createdBy == resource.data.createdBy
          )
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'deletedAt', 'purgeAt', 'deletedBy', 'clientRequestId',
              'statusBeforeTrash'
            ])
          && !(request.resource.data.get('status', 'upcoming') in ['trashed', 'purging'])
          // staffIds/clientUserIds move only through the Admin-SDK
          // share/unshare routes, which write the array and the
          // members/{uid} doc atomically. Blocked here for every caller,
          // including the creator — a direct client-side write would desync
          // the array from real membership and recreate the stale-index bug.
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['staffIds', 'clientUserIds']);

        allow delete: if false;

        match /members/{memberId} {
          allow read: if isProjectCreatorOf(companyId, projectId)
            || (signedIn() && request.auth.uid == memberId);
          allow write: if false;
        }

        match /invitations/{invitationId} {
          allow read: if isProjectCreatorOf(companyId, projectId);
          allow write: if false;
        }

        match /schedule/{itemId} {
          // Missing clientVisible defaults to true for legacy Schedule docs.
          allow read: if canManageProject(companyId, projectId)
            || colleagueAllows(companyId, projectId, 'viewSchedule')
            || (
              isAssignedClient(companyId, projectId)
              && resource.data.get('clientVisible', true) != false
            );
          allow create: if (
              canManageProject(companyId, projectId)
              || colleagueAllows(companyId, projectId, 'updateSchedule')
            )
            && (
              request.resource.data.get('clientVisible', false) != true
              || canPublishToClient(companyId, projectId)
            );
          allow update: if (
              canManageProject(companyId, projectId)
              || colleagueAllows(companyId, projectId, 'updateSchedule')
            )
            && (
              request.resource.data.get('clientVisible', false) != true
              || resource.data.get('clientVisible', false) == true
              || canPublishToClient(companyId, projectId)
            );
          allow delete: if canManageProject(companyId, projectId)
            || colleagueAllows(companyId, projectId, 'updateSchedule');
        }

        match /dailyPlans/{planId} {
          // Same backward-compatible model as Schedule: missing clientVisible
          // behaves as true for existing records.
          allow read: if canManageProject(companyId, projectId)
            || colleagueAllows(companyId, projectId, 'viewSchedule')
            || (
              isAssignedClient(companyId, projectId)
              && resource.data.get('clientVisible', true) != false
            );
          allow create: if (
              canManageProject(companyId, projectId)
              || colleagueAllows(companyId, projectId, 'updateSchedule')
            );
          allow update: if (
              canManageProject(companyId, projectId)
              || colleagueAllows(companyId, projectId, 'updateSchedule')
            );
          allow delete: if canManageProject(companyId, projectId)
            || colleagueAllows(companyId, projectId, 'updateSchedule');
        }

        match /updates/{updateId} {
          allow read: if canManageProject(companyId, projectId)
            || colleagueAllows(companyId, projectId, 'viewJournal')
            || (
              isAssignedClient(companyId, projectId)
              && resource.data.visibility == 'client_visible'
            );
          allow create: if (
              canManageProject(companyId, projectId)
              || colleagueAllows(companyId, projectId, 'addJournal')
            )
            && (
              request.resource.data.get('visibility', 'internal') != 'client_visible'
              || canPublishToClient(companyId, projectId)
            );
          allow update: if (
              canManageProject(companyId, projectId)
              || colleagueAllows(companyId, projectId, 'editAllJournal')
              || canEditOwnJournal(companyId, projectId)
            )
            && (
              request.resource.data.get('visibility', 'internal') != 'client_visible'
              || resource.data.get('visibility', 'internal') == 'client_visible'
              || canPublishToClient(companyId, projectId)
            );
          allow delete: if canManageProject(companyId, projectId)
            || colleagueAllows(companyId, projectId, 'deleteAllJournal')
            || canDeleteOwnJournal(companyId, projectId);
        }

        match /media/{mediaId} {
          function mediaNotTombstoned() {
            return !('status' in resource.data)
              || !(resource.data.status in ['DELETED', 'CANCELLED']);
          }

          allow read: if mediaNotTombstoned()
            && (
              canManageProject(companyId, projectId)
              || colleagueAllows(companyId, projectId, 'viewMedia')
              || (
                isAssignedClient(companyId, projectId)
                && (
                  resource.data.clientVisible == true
                  || resource.data.visibility in ['client_visible', 'handover']
                )
              )
            );

          allow create: if (
              canManageProject(companyId, projectId)
              || colleagueAllows(companyId, projectId, 'uploadMedia')
            )
            && (!requestIsClientVisible() || canPublishToClient(companyId, projectId))
            && (
              !('provider' in request.resource.data)
              || request.resource.data.provider != 'BUNNY_STREAM'
            )
            && !('bunnyVideoId' in request.resource.data);

          allow update: if (
              canManageProject(companyId, projectId)
              || colleagueAllows(companyId, projectId, 'editAllMedia')
              || canEditOwnMedia(companyId, projectId)
              || colleagueAllows(companyId, projectId, 'publishMediaToClient')
            )
            && (
              !(requestIsClientVisible() && !resourceIsClientVisible())
              || canPublishToClient(companyId, projectId)
            )
            && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny([
                'bunnyVideoId', 'bunnyLibraryId', 'provider',
                'workspaceId', 'companyId', 'projectId', 'uploadedBy',
                'createdAt', 'readyAt', 'status', 'storageSizeBytes',
                'encodeProgress', 'sourceSizeBytes', 'clientUploadId',
                'mediaLifecycle'
              ]);

          allow delete: if canManageProject(companyId, projectId)
            || colleagueAllows(companyId, projectId, 'deleteAllMedia')
            || canDeleteOwnMedia(companyId, projectId);
        }

        match /purchases/{purchaseId} {
          // Client may only READ OWNER-responsibility Purchases. Never
          // STUDIO. Clients have no create/update/delete path at all.
          allow read: if canManageProject(companyId, projectId)
            || colleagueAllows(companyId, projectId, 'viewPurchases')
            || (
              isAssignedClient(companyId, projectId)
              && resource.data.purchaseResponsibility == 'OWNER'
            );

          allow create: if canManageProject(companyId, projectId)
            || colleagueAllows(companyId, projectId, 'editPurchases');

          allow update: if canManageProject(companyId, projectId)
            || colleagueAllows(companyId, projectId, 'editPurchases');

          allow delete: if canManageProject(companyId, projectId)
            || colleagueAllows(companyId, projectId, 'editPurchases');
        }
      }
    }
  }
}
