rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/companies/siteledger/users/$(request.auth.uid));
    }

    function profile() {
      return userDoc().data;
    }

    function isActiveUser() {
      return signedIn() && userDoc().exists && profile().active == true;
    }

    function isAdmin() {
      return isActiveUser() && profile().role == 'admin';
    }

    function isStaffSide() {
      return isActiveUser() && (profile().role == 'admin' || profile().role == 'staff');
    }

    function isClient() {
      return isActiveUser() && profile().role == 'client';
    }

    function projectDoc(projectId) {
      return get(/databases/$(database)/documents/companies/siteledger/projects/$(projectId)).data;
    }

    function canAccessProject(projectId) {
      return isAdmin()
        || (isStaffSide() && (
          request.auth.uid in projectDoc(projectId).staffIds
          || projectDoc(projectId).managerId == request.auth.uid
        ))
        || (isClient() && request.auth.uid in projectDoc(projectId).clientUserIds);
    }

    match /companies/{companyId} {
      allow read: if isActiveUser() && companyId == 'siteledger';
      allow write: if isAdmin() && companyId == 'siteledger';

      match /meta/{docId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && companyId == 'siteledger'
          && docId == 'setup'
          && !exists(/databases/$(database)/documents/companies/siteledger/meta/setup)
          && request.resource.data.adminUid == request.auth.uid
          && request.resource.data.completed == true;
        allow update, delete: if isAdmin();
      }

      match /users/{userId} {
        allow read: if isStaffSide() || (signedIn() && request.auth.uid == userId);
        // Admin invites others; first signed-in user may self-create as admin once.
        allow create: if isAdmin()
          || (signedIn()
              && request.auth.uid == userId
              && companyId == 'siteledger'
              && request.resource.data.role == 'admin'
              && request.resource.data.companyId == 'siteledger'
              && request.resource.data.active == true
              && !exists(/databases/$(database)/documents/companies/siteledger/meta/setup));
        allow update: if isAdmin()
          || (signedIn() && request.auth.uid == userId
              && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['role', 'active', 'companyId', 'projectIds']));
        allow delete: if isAdmin();
      }

      match /workCategories/{categoryId} {
        allow read: if isStaffSide();
        allow write: if isAdmin();
      }

      match /reminders/{reminderId} {
        allow read: if isStaffSide();
        allow write: if isStaffSide();
      }

      match /projects/{projectId} {
        allow read: if isStaffSide()
          || (isClient() && request.auth.uid in resource.data.clientUserIds);
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || isStaffSide();

        match /schedule/{itemId} {
          allow read: if isStaffSide()
            || (isClient() && request.auth.uid in projectDoc(projectId).clientUserIds);
          allow write: if isStaffSide();
        }

        match /dailyPlans/{planId} {
          allow read: if isStaffSide()
            || (isClient() && request.auth.uid in projectDoc(projectId).clientUserIds);
          allow write: if isStaffSide();
        }

        match /updates/{updateId} {
          allow read: if isStaffSide()
            || (isClient()
                && request.auth.uid in projectDoc(projectId).clientUserIds
                && resource.data.visibility == 'client_visible');
          allow create: if isStaffSide();
          allow update, delete: if isAdmin();
        }

        match /media/{mediaId} {
          allow read: if isStaffSide()
            || (isClient()
                && request.auth.uid in projectDoc(projectId).clientUserIds
                && resource.data.visibility in ['client_visible', 'handover']);
          allow create: if isStaffSide();
          allow update, delete: if isAdmin() || isStaffSide();
        }

        match /purchases/{purchaseId} {
          allow read: if isStaffSide()
            || (isClient()
                && request.auth.uid in projectDoc(projectId).clientUserIds);

          allow create: if isStaffSide()
            || (isClient()
                && request.auth.uid in projectDoc(projectId).clientUserIds
                && request.resource.data.purchaseResponsibility == 'OWNER'
                && request.resource.data.projectId == projectId);

          allow update: if isStaffSide()
            || (isClient()
                && request.auth.uid in projectDoc(projectId).clientUserIds
                && resource.data.purchaseResponsibility == 'OWNER'
                && request.resource.data.purchaseResponsibility == 'OWNER');

          allow delete: if isStaffSide();
        }
      }
    }
  }
}
