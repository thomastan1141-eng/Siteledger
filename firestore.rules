rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function accountDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasAccount() {
      return signedIn() && accountDoc().exists;
    }

    function account() {
      return accountDoc().data;
    }

    function memberDoc(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function isWorkspaceMember(workspaceId) {
      return isVerifiedUser()
        && memberDoc(workspaceId).exists
        && memberDoc(workspaceId).data.status == 'ACTIVE';
    }

    function isWorkspaceOwner(workspaceId) {
      return isWorkspaceMember(workspaceId)
        && memberDoc(workspaceId).data.role == 'OWNER';
    }

    function companyUserDoc(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid));
    }

    function hasCompanyUser(companyId) {
      return signedIn() && companyUserDoc(companyId).exists
        && companyUserDoc(companyId).data.active == true;
    }

    function companyProfile(companyId) {
      return companyUserDoc(companyId).data;
    }

    function isCompanyAdmin(companyId) {
      return hasCompanyUser(companyId) && companyProfile(companyId).role == 'admin';
    }

    function isCompanyStaffSide(companyId) {
      return hasCompanyUser(companyId)
        && companyProfile(companyId).role in ['admin', 'staff'];
    }

    function isCompanyClient(companyId) {
      return hasCompanyUser(companyId) && companyProfile(companyId).role == 'client';
    }

    function projectDoc(companyId, projectId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/projects/$(projectId)).data;
    }

    function canAccessProject(companyId, projectId) {
      return isCompanyAdmin(companyId)
        || (isCompanyStaffSide(companyId) && (
          request.auth.uid in projectDoc(companyId, projectId).staffIds
          || projectDoc(companyId, projectId).managerId == request.auth.uid
          || isWorkspaceMember(companyId)
        ))
        || (isCompanyClient(companyId)
            && request.auth.uid in projectDoc(companyId, projectId).clientUserIds);
    }

    // ---- Top-level SaaS users ----
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if false; // created via Admin SDK onboarding
      allow update: if signedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'role', 'active', 'defaultWorkspaceId', 'companyId',
              'onboardingComplete', 'plan', 'subscriptionStatus'
            ]);
      allow delete: if false;
    }

    // ---- Workspaces ----
    match /workspaces/{workspaceId} {
      allow read: if isWorkspaceMember(workspaceId);
      allow create: if false; // Admin SDK only
      allow update: if isWorkspaceOwner(workspaceId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'ownerUid', 'plan', 'subscriptionStatus',
              'trialStartsAt', 'trialEndsAt'
            ]);
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow write: if false; // Admin SDK / future owner APIs
      }
    }

    // ---- Tenant data (companyId == workspaceId) ----
    match /companies/{companyId} {
      allow read: if isWorkspaceMember(companyId) || hasCompanyUser(companyId);
      allow write: if isCompanyAdmin(companyId) || isWorkspaceOwner(companyId);

      match /meta/{docId} {
        allow read: if signedIn();
        // Legacy bootstrap retained for existing admin migration path.
        allow create: if signedIn()
          && docId == 'setup'
          && !exists(/databases/$(database)/documents/companies/$(companyId)/meta/setup)
          && request.resource.data.adminUid == request.auth.uid
          && request.resource.data.completed == true;
        allow update, delete: if isCompanyAdmin(companyId);
      }

      match /users/{userId} {
        allow read: if isCompanyStaffSide(companyId)
          || (signedIn() && request.auth.uid == userId);
        allow create: if isCompanyAdmin(companyId)
          || (signedIn()
              && request.auth.uid == userId
              && request.resource.data.role == 'admin'
              && request.resource.data.companyId == companyId
              && request.resource.data.active == true
              && !exists(/databases/$(database)/documents/companies/$(companyId)/meta/setup));
        allow update: if isCompanyAdmin(companyId)
          || (signedIn() && request.auth.uid == userId
              && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['role', 'active', 'companyId', 'projectIds']));
        allow delete: if isCompanyAdmin(companyId);
      }

      match /workCategories/{categoryId} {
        allow read: if isCompanyStaffSide(companyId) || isWorkspaceMember(companyId);
        allow write: if isCompanyAdmin(companyId);
      }

      match /reminders/{reminderId} {
        allow read, write: if isCompanyStaffSide(companyId) || isWorkspaceMember(companyId);
      }

      match /projects/{projectId} {
        allow read: if isCompanyAdmin(companyId)
          || isWorkspaceOwner(companyId)
          || (hasCompanyUser(companyId)
              && companyProfile(companyId).role == 'staff'
              && (
                request.auth.uid in resource.data.staffIds
                || resource.data.managerId == request.auth.uid
              ))
          || (isCompanyClient(companyId)
              && request.auth.uid in resource.data.clientUserIds);

        allow create: if (isCompanyAdmin(companyId) || isWorkspaceOwner(companyId))
          && request.resource.data.workspaceId == companyId
          && request.resource.data.companyId == companyId
          && request.resource.data.createdBy == request.auth.uid;

        allow update: if (isCompanyAdmin(companyId)
            || isWorkspaceOwner(companyId)
            || (hasCompanyUser(companyId)
                && companyProfile(companyId).role == 'staff'
                && (
                  request.auth.uid in resource.data.staffIds
                  || resource.data.managerId == request.auth.uid
                )))
          && request.resource.data.companyId == resource.data.companyId
          // workspaceId / createdBy immutable once set; may be stamped on legacy docs.
          && (
            !('workspaceId' in resource.data)
            || resource.data.workspaceId == null
            || request.resource.data.workspaceId == resource.data.workspaceId
          )
          && (
            !('createdBy' in resource.data)
            || resource.data.createdBy == null
            || request.resource.data.createdBy == resource.data.createdBy
          );

        allow delete: if isCompanyAdmin(companyId) || isWorkspaceOwner(companyId);

        match /members/{memberId} {
          allow read: if isCompanyAdmin(companyId)
            || isWorkspaceOwner(companyId)
            || (signedIn() && request.auth.uid == memberId);
          allow write: if false; // Admin SDK only
        }

        match /schedule/{itemId} {
          allow read: if isCompanyStaffSide(companyId)
            || isWorkspaceMember(companyId)
            || (isCompanyClient(companyId)
                && request.auth.uid in projectDoc(companyId, projectId).clientUserIds);
          allow write: if isCompanyStaffSide(companyId) || isWorkspaceMember(companyId);
        }

        match /dailyPlans/{planId} {
          allow read: if isCompanyStaffSide(companyId)
            || isWorkspaceMember(companyId)
            || (isCompanyClient(companyId)
                && request.auth.uid in projectDoc(companyId, projectId).clientUserIds);
          allow write: if isCompanyStaffSide(companyId) || isWorkspaceMember(companyId);
        }

        match /updates/{updateId} {
          allow read: if isCompanyStaffSide(companyId)
            || isWorkspaceMember(companyId)
            || (isCompanyClient(companyId)
                && request.auth.uid in projectDoc(companyId, projectId).clientUserIds
                && resource.data.visibility == 'client_visible');
          allow create: if isCompanyStaffSide(companyId) || isWorkspaceMember(companyId);
          allow update, delete: if isCompanyAdmin(companyId)
            || isCompanyStaffSide(companyId)
            || isWorkspaceMember(companyId);
        }

        match /media/{mediaId} {
          allow read: if isCompanyStaffSide(companyId)
            || isWorkspaceMember(companyId)
            || (isCompanyClient(companyId)
                && request.auth.uid in projectDoc(companyId, projectId).clientUserIds
                && resource.data.visibility in ['client_visible', 'handover']);
          allow create: if isCompanyStaffSide(companyId) || isWorkspaceMember(companyId);
          allow update, delete: if isCompanyAdmin(companyId)
            || isCompanyStaffSide(companyId)
            || isWorkspaceMember(companyId);
        }

        match /purchases/{purchaseId} {
          allow read: if isCompanyStaffSide(companyId)
            || isWorkspaceMember(companyId)
            || (isCompanyClient(companyId)
                && request.auth.uid in projectDoc(companyId, projectId).clientUserIds);

          allow create: if isCompanyStaffSide(companyId)
            || isWorkspaceMember(companyId)
            || (isCompanyClient(companyId)
                && request.auth.uid in projectDoc(companyId, projectId).clientUserIds
                && request.resource.data.purchaseResponsibility == 'OWNER'
                && request.resource.data.projectId == projectId);

          allow update: if isCompanyStaffSide(companyId)
            || isWorkspaceMember(companyId)
            || (isCompanyClient(companyId)
                && request.auth.uid in projectDoc(companyId, projectId).clientUserIds
                && resource.data.purchaseResponsibility == 'OWNER'
                && request.resource.data.purchaseResponsibility == 'OWNER');

          allow delete: if isCompanyStaffSide(companyId) || isWorkspaceMember(companyId);
        }
      }
    }
  }
}
