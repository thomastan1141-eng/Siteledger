rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function memberDoc(workspaceId) {
      return firestore.get(/databases/(default)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function isWorkspaceOwner(workspaceId) {
      return signedIn()
        && memberDoc(workspaceId).exists
        && memberDoc(workspaceId).data.status == 'ACTIVE'
        && memberDoc(workspaceId).data.role == 'OWNER';
    }

    function companyUserDoc(companyId) {
      return firestore.get(/databases/(default)/documents/companies/$(companyId)/users/$(request.auth.uid));
    }

    function isCompanyAdmin(companyId) {
      return signedIn()
        && companyUserDoc(companyId).data.active == true
        && companyUserDoc(companyId).data.role == 'admin';
    }

    function isTenantAdmin(companyId) {
      return isCompanyAdmin(companyId) || isWorkspaceOwner(companyId);
    }

    function isClient(companyId) {
      return signedIn()
        && companyUserDoc(companyId).data.active == true
        && companyUserDoc(companyId).data.role == 'client';
    }

    function projectData(companyId, projectId) {
      return firestore.get(/databases/(default)/documents/companies/$(companyId)/projects/$(projectId)).data;
    }

    function projectMemberDoc(companyId, projectId) {
      return firestore.get(/databases/(default)/documents/companies/$(companyId)/projects/$(projectId)/members/$(request.auth.uid));
    }

    function projectNotTrashed(companyId, projectId) {
      return !('status' in projectData(companyId, projectId))
        || !(projectData(companyId, projectId).status in ['trashed', 'purging']);
    }

    function isClientOnProject(companyId, projectId) {
      return isClient(companyId)
        && request.auth.uid in projectData(companyId, projectId).get('clientUserIds', [])
        && projectMemberDoc(companyId, projectId).exists
        && projectMemberDoc(companyId, projectId).data.get('status', '') == 'ACTIVE';
    }

    function isAssignedStaffOnProject(companyId, projectId) {
      return signedIn()
        && request.auth.uid in projectData(companyId, projectId).get('staffIds', [])
        && projectMemberDoc(companyId, projectId).exists
        && projectMemberDoc(companyId, projectId).data.get('status', '') == 'ACTIVE';
    }

    function isProjectCreator(companyId, projectId) {
      return signedIn()
        && projectData(companyId, projectId).get('createdBy', '') == request.auth.uid;
    }

    function canAccessProjectFiles(companyId, projectId) {
      return isTenantAdmin(companyId)
        || isProjectCreator(companyId, projectId)
        || isAssignedStaffOnProject(companyId, projectId);
    }

    function canWritePhoto() {
      return request.resource.size < 200 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
    }

    match /companies/{companyId}/projects/{projectId}/updates/{date}/{folder}/{fileName} {
      allow read: if projectNotTrashed(companyId, projectId)
        && (
          canAccessProjectFiles(companyId, projectId)
          || (isClientOnProject(companyId, projectId) && folder in ['photos', 'handover'])
        );
      allow write: if projectNotTrashed(companyId, projectId)
        && canAccessProjectFiles(companyId, projectId)
        && canWritePhoto();
    }

    match /companies/{companyId}/projects/{projectId}/3d/{fileName} {
      allow read: if canAccessProjectFiles(companyId, projectId)
        || isClientOnProject(companyId, projectId);
      allow write: if canAccessProjectFiles(companyId, projectId)
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /companies/{companyId}/projects/{projectId}/cover/{fileName} {
      allow read: if canAccessProjectFiles(companyId, projectId)
        || isClientOnProject(companyId, projectId);
      allow write: if canAccessProjectFiles(companyId, projectId)
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /companies/{companyId}/projects/{projectId}/purchases/{purchaseId}/photos/{fileName} {
      allow read: if canAccessProjectFiles(companyId, projectId)
        || isClientOnProject(companyId, projectId);
      allow write: if (
          canAccessProjectFiles(companyId, projectId)
          || isClientOnProject(companyId, projectId)
        )
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if canAccessProjectFiles(companyId, projectId)
        || isClientOnProject(companyId, projectId);
    }

    match /workspaces/{workspaceId}/projects/{projectId}/cover/{fileName} {
      allow read: if canAccessProjectFiles(workspaceId, projectId)
        || isClientOnProject(workspaceId, projectId);
      allow write: if canAccessProjectFiles(workspaceId, projectId)
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /workspaces/{workspaceId}/projects/{projectId}/journal/{fileName} {
      allow read: if canAccessProjectFiles(workspaceId, projectId);
      allow write: if canAccessProjectFiles(workspaceId, projectId)
        && canWritePhoto();
    }

    match /workspaces/{workspaceId}/projects/{projectId}/purchases/{purchaseId}/{fileName} {
      allow read: if canAccessProjectFiles(workspaceId, projectId)
        || isClientOnProject(workspaceId, projectId);
      allow write: if canAccessProjectFiles(workspaceId, projectId)
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
