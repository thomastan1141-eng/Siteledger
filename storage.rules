rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/companies/starry-home/users/$(request.auth.uid));
    }

    function isStaffSide() {
      return signedIn()
        && userDoc().data.active == true
        && userDoc().data.role in ['admin', 'staff'];
    }

    function isClient() {
      return signedIn()
        && userDoc().data.active == true
        && userDoc().data.role == 'client';
    }

    function projectData(projectId) {
      return firestore.get(/databases/(default)/documents/companies/starry-home/projects/$(projectId)).data;
    }

    function isClientOnProject(projectId) {
      return isClient() && request.auth.uid in projectData(projectId).clientUserIds;
    }

    match /companies/starry-home/projects/{projectId}/updates/{date}/{folder}/{fileName} {
      allow read: if isStaffSide()
        || (isClientOnProject(projectId) && folder in ['photos', 'videos', 'handover']);
      allow write: if isStaffSide()
        && request.resource.size < 200 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
          || request.resource.contentType == 'application/pdf'
        );
    }

    match /companies/starry-home/projects/{projectId}/3d/{fileName} {
      allow read: if isStaffSide() || isClientOnProject(projectId);
      allow write: if isStaffSide()
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /companies/starry-home/projects/{projectId}/purchases/{purchaseId}/photos/{fileName} {
      allow read: if isStaffSide() || isClientOnProject(projectId);
      allow write: if (isStaffSide() || isClientOnProject(projectId))
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isStaffSide() || isClientOnProject(projectId);
    }
  }
}
